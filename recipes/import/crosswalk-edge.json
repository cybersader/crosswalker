{
  "recipe": "olir-crosswalk-edge",
  "source": { "ontology": "xwalk", "levels": ["edge"] },
  "target": {
    "layout": [
      {
        "level": "edge",
        "mechanism": "file",
        "template": "cw-{subject_id|slug}--{object_id|slug}.md",
        "kind": "crosswalk-edge"
      }
    ],
    "also_emit": {
      "frontmatter": {
        "managed": {
          "subject_id": "{subject_id}",
          "predicate_id": "{strm_predicate}",
          "object_id": "{object_id}",
          "subject_note": "{subject_note|optional}",
          "object_note": "{object_note|optional}",
          "mapping_set_id": "{mapping_set_id|optional}",
          "predicate_modifier": "{predicate_modifier|optional}",
          "subject_group": "{subject_group}",
          "object_group": "{object_group}",
          "source_framework": "{source_framework}",
          "target_framework": "{target_framework}",
          "match_confidence": "{match_confidence|number}",
          "mapping_justification": "{mapping_justification}",
          "mapping_provider": "{mapping_provider}",
          "sssom_predicate": "{sssom_predicate}"
        }
      }
    }
  }
}
