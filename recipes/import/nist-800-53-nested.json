{
  "$comment": "Nested stack variant of the NIST control-catalog recipe. It uses the same XLSX catalog column binding and body as the flat recipe. Family folders do not produce notes; family-level mapping endpoints remain unresolved until the separate family concept-note design. Controls host their own folders, and enhancements are files alongside those control folder notes.",
  "recipe": "nist-800-53-r5-nested",
  "source": {
    "ontology": "nist-800-53",
    "levels": [
      "family",
      "control",
      "entry"
    ]
  },
  "target": {
    "auto_heading": "{name}",
    "layout": [
      {
        "level": "family",
        "mechanism": "folder",
        "template": "{identifier|prefix(-,0)}"
      },
      {
        "level": "control",
        "mechanism": "folder",
        "template": "{identifier|prefix(\\(,0)}"
      },
      {
        "level": "entry",
        "mechanism": "file",
        "template": "{identifier|fs-safe}.md"
      }
    ],
    "also_emit": {
      "frontmatter": {
        "managed": {
          "title": "{name}",
          "control_id": "{identifier}",
          "related_curies": "{related|optional|split(,)|trim(.)|reject(^\\[None\\]$)|curie-prefix(nist-800-53)}",
          "family": "{identifier|prefix(-,0)}"
        },
        "user_preserve": [
          "reviewer",
          "status",
          "notes"
        ]
      },
      "body": [
        {
          "template": "{control_text|trim}",
          "position": "section",
          "heading": "Control",
          "heading_depth": 2,
          "format": "text"
        },
        {
          "template": "{discussion|trim}",
          "position": "section",
          "heading": "Discussion",
          "heading_depth": 2,
          "format": "text"
        },
        {
          "template": "{related|optional|split(,)|trim(.)|reject(^\\[None\\]$)|wikilink}",
          "position": "section",
          "heading": "Related controls",
          "heading_depth": 2,
          "format": "list"
        }
      ]
    }
  }
}
