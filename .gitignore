# Build output (root level)
/main.js
# Legacy loose SQLite artifacts are no longer emitted, but remain ignored so
# pre-existing local copies cannot be committed accidentally.
/sqlite3.wasm
/sqlite3.mjs
*.js.map

# npm
node_modules/

# Obsidian workspace (user-specific)
**/workspace.json
**/workspace-mobile.json

# Root .obsidian — keep config, ignore user-specific state
/.obsidian/workspace.json
/.obsidian/workspace-mobile.json
/.obsidian/cache/
/.obsidian/plugins/*/data.json

# Test vault - ignore build artifacts and cache, keep test data
test-vault/.obsidian/plugins/crosswalker/main.js
test-vault/.obsidian/plugins/crosswalker/manifest.json
test-vault/.obsidian/plugins/crosswalker/styles.css
test-vault/.obsidian/plugins/crosswalker/sqlite3.wasm
test-vault/.obsidian/plugins/crosswalker/sqlite3.mjs
test-vault/.obsidian/cache/
test-vault/.obsidian/plugins/*/data.json

# First-run E2E fixture: launcher/plugin copies can be stranded by a killed run.
# Only the two .obsidian JSON files under this fixture are tracked, both outside
# plugins/, so ignoring this subtree untracks nothing.
tests/e2e/first-run-vault/.obsidian/plugins/

# Runtime state written by the plugin's first-run hook
test-vault/_crosswalker/

# In-vault copies of TEST_*.md guides (canonical lives at repo root)
test-vault/_test-guides/

# On-demand visual verification screenshots from wdio runs
test-screenshots/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Test coverage
coverage/

# Logs
*.log
npm-debug.log*

# TypeScript cache
*.tsbuildinfo

# Environment
.env
.env.local

# Local personal identifiers used by the personal-data gate
.personal-data-denylist

# Claude Code local settings (contains user-specific paths)
.claude/settings.local.json
.claude/plans/

# Portagenty publishing tool — local state
*.portagenty.toml

# wdio-obsidian-service downloaded Obsidian builds + test results
.obsidian-cache/
test-results/
.wdio-vscode-service/

# Local workspace — folder tracked (so contributors get it), contents ignored
.workspace/*
!.workspace/.gitkeep

# E2E test artifacts
test-results/

# Docs site
docs/node_modules/
docs/dist/
docs/.astro/
docs/playwright-report/
docs/blob-report/

# Python
__pycache__/
*.py[cod]
*.egg-info/
venv/
.ipynb_checkpoints/

# Python output
cri_framework/
frameworks_export.xlsx

# Copyrighted framework source files — local only, never committed
test-vault/Frameworks/_licensed/

# === Repo-root framework corpus (raw downloads, ~400MB, mixed licensing) ===
# Fail-closed: everything under Frameworks/ is local-by-default. Copyrighted
# vendor files (CRI, CIS, ISO, SOC2/AICPA, PCI, SCF, CIS RAM) must NEVER be
# committed — they live here locally only. The public-domain NIST/MITRE source
# files that are already tracked stay tracked (gitignore doesn't untrack).
# To commit a NEW public-domain file, add it explicitly: git add -f Frameworks/<file>
Frameworks/
# Belt-and-suspenders: copyrighted source files always stay local regardless of path.
Frameworks/_licensed/

# Runtime artifacts (2026-06-12 knowledge-ops sweep)
.claude/scheduled_tasks.lock
# CK semantic-search index cache (MCP tool artifact, like docs/.astro)
docs/src/content/docs/.ck/
# Ephemeral user scratch notes in the test vault (wizard outputs, untitled)
test-vault/Untitled.md
test-vault/Test Query*.md

# Crosswalker debug logs (rotated)
test-vault/crosswalker-debug.log*
