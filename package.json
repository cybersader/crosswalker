{
	"name": "crosswalker",
	"version": "0.1.1",
	"description": "Import structured ontologies into Obsidian with hierarchical folder structures, typed links, and metadata.",
	"main": "main.js",
	"scripts": {
		"dev": "bun run esbuild.config.mjs",
		"build": "bun x tsc -noEmit -skipLibCheck && bun run esbuild.config.mjs production",
		"serve": "bun scripts/serve.mjs",
		"serve:docs": "bun scripts/serve.mjs docs",
		"serve:plugin": "bun scripts/serve.mjs plugin",
		"serve:both": "bun scripts/serve.mjs both",
		"serve:share": "bun scripts/serve.mjs tailscale",
		"check:mdx": "bun scripts/check-mdx.mjs",
		"check:log-labels": "bun scripts/check-log-labels.mjs",
		"check:frontmatter": "node scripts/check-frontmatter.mjs",
		"check:not-content": "node scripts/check-not-content.mjs",
		"check:personal-data": "node scripts/check-personal-data.mjs",
		"check:links": "node scripts/check-links.mjs",
		"version": "bun run version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint src",
		"lint:fix": "eslint src --fix",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:golden": "jest --testPathPattern \"consumer-contracts|golden-invariants|golden-drift\"",
		"golden:regen": "CW_GOLDEN_REGEN=1 jest --runTestsByPath tests/golden-regen.test.ts",
		"e2e": "wdio run wdio.conf.mts",
		"e2e:xvfb": "env -u WAYLAND_DISPLAY xvfb-run -a -s \"-screen 0 1600x1000x24\" wdio run wdio.conf.mts",
		"e2e:clean": "node scripts/e2e-clean.mjs",
		"fixtures": "bun tools/generate-fixtures.ts --source tools/fixtures/synthetic/nist-mini.csv --target test-vault/Frameworks/NIST-mini --ontology nist-mini --clean --deterministic --examples tools/fixtures/examples",
		"reset": "node scripts/reset-test-vault.mjs",
		"check:fixtures-drift": "bun scripts/check-fixtures-drift.mjs",
		"codegen": "bun tools/codegen-types.ts"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"frameworks",
		"ontology",
		"taxonomy",
		"compliance",
		"GRC",
		"crosswalk",
		"import"
	],
	"author": "cybersader",
	"license": "MIT",
	"devDependencies": {
		"@eslint/json": "^0.14.0",
		"@types/jest": "^29.5.0",
		"@types/mocha": "^10.0.10",
		"@types/node": "^20.10.0",
		"@types/papaparse": "^5.3.14",
		"@typescript-eslint/parser": "^8.48.1",
		"@typescript-eslint/utils": "^8.48.1",
		"@wdio/cli": "^9.27.0",
		"@wdio/local-runner": "^9.27.0",
		"@wdio/mocha-framework": "^9.27.0",
		"ajv": "^8.20.0",
		"ajv-formats": "^3.0.1",
		"builtin-modules": "^3.3.0",
		"esbuild": "0.19.0",
		"eslint": "^9.39.1",
		"eslint-plugin-obsidianmd": "^0.1.9",
		"jest": "^29.7.0",
		"jest-environment-jsdom": "^29.7.0",
		"json-schema-to-typescript": "^15.0.4",
		"obsidian": "latest",
		"ts-jest": "^29.1.0",
		"tslib": "2.6.0",
		"typescript": "5.2.2",
		"typescript-eslint": "^8.48.1",
		"wdio-obsidian-reporter": "^3.0.2",
		"wdio-obsidian-service": "^3.0.2"
	},
	"dependencies": {
		"@sqlite.org/sqlite-wasm": "^3.53.0-build1",
		"jsonata": "^2.2.2",
		"papaparse": "^5.4.1",
		"xlsx": "^0.18.5"
	}
}
