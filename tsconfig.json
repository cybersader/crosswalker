{
	"compilerOptions": {
		"inlineSourceMap": true,
		"inlineSources": true,
		"module": "ESNext",
		"target": "ES6",
		"allowJs": true,
		"noImplicitAny": true,
		"moduleResolution": "bundler",
		"importHelpers": true,
		"isolatedModules": true,
		"strictNullChecks": true,
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"lib": [
			"DOM",
			"ES5",
			"ES6",
			"ES7"
		],
		"outDir": "./dist",
		"rootDir": ".",
		"types": ["node", "jest"]
	},
	"include": [
		"src/**/*.ts",
		"spec/**/*.json"
	],
	"exclude": [
		"node_modules"
	]
}
